[sub_resource type="GDScript" id="GDScript_doo73"]
script/source = "extends RigidBody3D

# Объекты, которые нужно скрыть и активировать при коллизии
@export var damage = 10
@onready var bullet_1 = $Watermelon
@onready var partic = [$GPUParticles3D,$GPUParticles3D2,$GPUParticles3D3,$GPUParticles3D4]
@onready var collision = $hurtbox/CollisionShape3D
@onready var colision_s = $CollisionShape3D
@onready var play_m = $AudioStreamPlayer3D
@onready var shape_cast_3d = $ShapeCast3D
@onready var decal = preload(\"res://scen/decals/decal.tscn\")
var user_prefs: UserPref
var high_graphics
func _ready():
	Event.connect(\"global_op\",op_d)
	user_prefs = UserPref.load_or_create()
	op_d()
func  op_d():
	high_graphics = user_prefs.high_graphics
func _process(delta):
	if shape_cast_3d.is_colliding():
		shape_cast_3d.enabled = false
		expp()

func expp():
	colision_s.disabled = true
	bullet_1.visible = false
	#var decali = decal.instantiate()
	#add_child(decali)
	if high_graphics == true:
		partic[0].amount +=20
		partic[1].amount +=20
	partic[0].emitting = true
	partic[1].emitting = true
	partic[3].emitting = true
	#partic[2].emitting = true
	$\".\".sleeping = true
	collision.disabled = false
	play_m.playing = true
	await get_tree().create_timer(0.1).timeout # таймер
	collision.disabled = true
	await get_tree().create_timer(3.0).timeout
	queue_free()

func _on_timer_timeout():
	queue_free() # Удаляем текущий объект из сцены


#func _on_hurtbox_body_entered(body):
	#if body is CharacterBody3D:
		## Вычисляем направление отталкивания от центра Area3D
		#var direction = (body.global_transform.origin - self.global_transform.origin).normalized()
		#
		## Вычисляем отталкивающую силу
		#var force = direction * 25.0
		#
		## Применяем силу к телу, изменяя его скорость
		#body.velocity += force
"

